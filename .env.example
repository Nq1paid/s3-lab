# S3 LAB needs no secrets to run. This file exists so that if you add an
# integration that does -- a broker API, a data vendor -- the key lives here
# and .gitignore keeps the real .env out of the repository.
#
# Copy to .env and fill in. Never commit .env.

# S3LAB_PORT=8765

# An extra timezone-detection case for tests/check_tz_detection.py, given as
# an absolute path and the timezone you expect it to be detected as.
# S3LAB_EXTRA_TZ_CASE=D:\exports\@NQ - 5 min - RTH.csv=America/New_York
