# --- secrets. Nothing in this list is ever committed.
# The engine needs no key, token or account to run, so anything matching here
# arrived from something else and does not belong in a public repository.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
credentials.json
secrets.json
secrets.*
*_secret*
*_token*
*.tokens
.netrc
id_rsa*
id_ed25519*
.aws/
.ssh/

# --- machine-local state. Yours, not the project's.
config.json
strategies/registry.json
run.bat
run-terminal.bat
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- run artifacts. Regenerated by the app; only the bundled example is kept.
runs/*
!runs/last_oos_trades.json
*.sqlite
data/cache/mappings.json

# --- market data. The 4-year NQ sample under data/cache is committed on
#     purpose so a clone works immediately. Your own full exports are not.
data/raw/
data/cache/*.parquet
!data/cache/NQ_1m_eth.parquet

# --- editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# The publish helper is for the person who owns the data, not for
# whoever clones it -- they have no repository of yours to push to.
PUSH-TO-GITHUB.bat
